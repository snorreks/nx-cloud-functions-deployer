{
	"name": "nx-cloud-functions-deployer",
	"type": "module",
	"version": "3.2.5",
	"description": "Nx plugin to manage firebase functions v2",
	"license": "MIT",
	"main": "index.js",
	"types": "index.d.ts",
	"repository": {
		"type": "git",
		"url": "https://github.com/snorreks/nx-cloud-functions-deployer"
	},
	"keywords": [
		"nx",
		"cloud",
		"functions",
		"firebase",
		"deploy",
		"esbuild",
		"monorepo",
		"typescript",
		"esm",
		"node",
		"scripts",
		"cache",
		"sam"
	],
	"homepage": "https://www.npmjs.com/package/nx-cloud-functions-deployer",
	"scripts": {
		"build": "tsx ./build-package.ts",
		"lint": "eslint ./src ./build-package.ts --ext .js,.ts",
		"validate": "tsc --noEmit",
		"format": "prettier --write src",
		"publish:stable": "cd dist && npm publish --no-git-checks",
		"publish:beta": "cd dist && npm publish --tag beta --no-git-checks"
	},
	"executors": "./executors.json",
	"peerDependencies": {
		"tsx": ">=3.0.0"
	},
	"dependencies": {
		"@inquirer/prompts": "^8.3.2",
		"chalk": "5.6.2",
		"dotenv": "^17.3.1",
		"nanospinner": "^1.2.2",
		"open": "11.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/app-types": "^0.9.3",
		"@google-cloud/firestore": "^8.3.0",
		"@nx/devkit": "^22.6.0",
		"@types/copy-paste": "^2.1.0",
		"@types/cross-spawn": "^6.0.6",
		"@types/express": "^5.0.6",
		"@types/fs-extra": "^11.0.4",
		"@types/inquirer": "^9.0.9",
		"@types/node": "^25.5.0",
		"copy-paste": "^2.2.0",
		"cross-spawn": "^7.0.6",
		"esbuild": "^0.27.4",
		"esbuild-node-externals": "^1.20.1",
		"esbuild-plugin-alias": "^0.2.1",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"execa": "^9.6.1",
		"firebase": "^12.11.0",
		"firebase-admin": "^13.7.0",
		"firebase-functions": "^7.2.2",
		"firebase-functions-test": "^3.4.1",
		"firebase-tools": "^15.11.0",
		"fs-extra": "^11.3.4",
		"jest": "^30.3.0",
		"nvexeca": "^11.0.4",
		"nx": "^22.6.0",
		"prettier": "^3.8.1",
		"tsc-alias": "^1.8.16",
		"tslib": "^2.8.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1"
	}
}
